# “””
SGP Oil KNN Intraday Strategy - Backtest

Reproduces the logic from the screenshots:

- Features: west_view, asia_view, diff_west_close, price_pos_*, weekday
- Model: KNN (k=3) with NCA preprocessing
- Target: asia_c = Asia close price - Decision time price
- Trade: Enter at Decision time, Exit at Asia close
- Long if prediction > 0, Short if prediction < 0

Time references (all in UTC, adjust if your df is in UTC):
WEST_OPEN_TIME  = 13:30 UTC (9:30pm SGT prev day ≈ NYC open equiv, but code uses SGT)

Since your df index timezone may vary, we define sessions in SGT (UTC+8):
ASIA_OPEN   = 08:00 SGT = 00:00 UTC
DECISION    = 12:00 SGT = 04:00 UTC
ASIA_CLOSE  = 18:00 SGT = 10:00 UTC
WEST_OPEN   = 21:00 SGT = 13:00 UTC  (prev day, i.e. NYC open)
WEST_CLOSE  = 05:00 SGT = 21:00 UTC  (prev day, i.e. NYSE overnight close)

Usage:
import pandas as pd
df = pd.read_parquet(“your_data.parquet”)  # index=Time, cols: Price, Asset, Contract, trading_day, Nearby
from sgp_oil_knn_backtest import run_backtest
results = run_backtest(df)
“””

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.gridspec as gridspec
from matplotlib.ticker import FuncFormatter
import warnings
warnings.filterwarnings(‘ignore’)

from sklearn.neighbors import KNeighborsClassifier, NeighborhoodComponentsAnalysis
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler

# ─── CONFIG ────────────────────────────────────────────────────────────────────

ASIA_OPEN_TIME   = (8,  0)   # SGT HH:MM
DECISION_TIME    = (12, 0)   # SGT - when we decide to trade
ASIA_CLOSE_TIME  = (18, 0)   # SGT - exit time
WEST_OPEN_TIME   = (21, 0)   # SGT previous day (NYC open)
WEST_CLOSE_TIME  = (5,  0)   # SGT same morning (NYC close / early morning)

PRICE_POS_LOOKBACKS = [5, 10, 20]   # rolling windows for price_pos features
KNN_NEIGHBORS       = 3
TRAIN_WINDOW        = 252           # rolling training window (trading days)
MIN_TRAIN_DAYS      = 60            # minimum days before first prediction
ASIA_PRICE_STD      = 0.5           # threshold to convert asia_c to categorical signal
TRANSACTION_COST    = 0.02          # $/bbl round trip (optional, set 0 to ignore)

# ───────────────────────────────────────────────────────────────────────────────

def localize_to_sgt(df: pd.DataFrame) -> pd.DataFrame:
“”“Ensure index is in SGT (UTC+8). Handles tz-aware and tz-naive.”””
idx = df.index
if idx.tz is None:
# Assume UTC if naive
df = df.copy()
df.index = idx.tz_localize(‘UTC’).tz_convert(‘Asia/Singapore’)
else:
df = df.copy()
df.index = idx.tz_convert(‘Asia/Singapore’)
return df

def get_price_at(df_day: pd.DataFrame, hh: int, mm: int) -> float:
“”“Get price at specific time on a day’s df (already filtered to that date).”””
target = df_day.index[df_day.index.hour == hh]
target = target[target.minute == mm]
if len(target) > 0:
val = df_day.loc[target[0], ‘Price’]
return val if pd.notna(val) else np.nan
# Fall back: nearest available
candidates = df_day[
(df_day.index.hour * 60 + df_day.index.minute) >= hh * 60 + mm
]
if len(candidates) > 0:
return candidates[‘Price’].iloc[0]
return np.nan

def build_daily_features(df: pd.DataFrame) -> pd.DataFrame:
“””
Construct daily feature table from minute data.

```
Features per trading day d:
    west_s       : price at WEST_OPEN_TIME on day d-1
    west_e       : price at WEST_CLOSE_TIME on day d   (early morning)
    west_view    : west_e - west_s  (overnight NYC session)
    asia_s       : price at ASIA_OPEN_TIME on day d-1
    asia_e       : price at ASIA_CLOSE_TIME on day d-1
    asia_view    : asia_e - asia_s  (yesterday's Asia session)
    ref_price    : price at DECISION_TIME on day d
    asia_close   : price at ASIA_CLOSE_TIME on day d  (target exit)
    diff_west_close : ref_price - west_e
    asia_c       : asia_close - ref_price  (TARGET)
    week         : isoweekday (1=Mon, 5=Fri; skip 6,7)
"""
df = localize_to_sgt(df)

# Get unique trading dates from the data
dates = sorted(df.index.normalize().unique())

records = []

for i in range(1, len(dates)):
    today = dates[i].date()
    prev  = dates[i-1].date()
    
    df_today = df[df.index.date == today]
    df_prev  = df[df.index.date == prev]
    
    if len(df_today) == 0 or len(df_prev) == 0:
        continue
    
    week = pd.Timestamp(today).isoweekday()
    if week in (6, 7):  # skip weekends
        continue
    
    # West session: prev day WEST_OPEN → today early morning WEST_CLOSE
    west_s = get_price_at(df_prev, *WEST_OPEN_TIME)
    west_e = get_price_at(df_today, *WEST_CLOSE_TIME)
    
    # Asia session yesterday
    asia_s = get_price_at(df_prev, *ASIA_OPEN_TIME)
    asia_e = get_price_at(df_prev, *ASIA_CLOSE_TIME)
    
    # Decision time today
    ref_price  = get_price_at(df_today, *DECISION_TIME)
    
    # Target: Asia close today
    asia_close = get_price_at(df_today, *ASIA_CLOSE_TIME)
    
    row = {
        'date':       today,
        'week':       week,
        'west_s':     west_s,
        'west_e':     west_e,
        'west_view':  west_e - west_s if pd.notna(west_e) and pd.notna(west_s) else np.nan,
        'asia_s':     asia_s,
        'asia_e':     asia_e,
        'asia_view':  asia_e - asia_s if pd.notna(asia_e) and pd.notna(asia_s) else np.nan,
        'ref_price':  ref_price,
        'asia_close': asia_close,
        'diff_west_close': ref_price - west_e if pd.notna(ref_price) and pd.notna(west_e) else np.nan,
        'asia_c':     asia_close - ref_price if pd.notna(asia_close) and pd.notna(ref_price) else np.nan,
    }
    records.append(row)

daily = pd.DataFrame(records).set_index('date')

# Price position features: ref_price / rolling_mean(west_e, N)
for lb in PRICE_POS_LOOKBACKS:
    daily[f'west_close_avg_{lb}'] = daily['west_e'].rolling(lb).mean()
    daily[f'price_pos_{lb}']      = daily['ref_price'] / daily[f'west_close_avg_{lb}']

# Weekday dummies
for d in range(1, 6):
    daily[f'week_{d}'] = (daily['week'] == d).astype(int)

# Convert asia_c to categorical signal: +1, -1, 0
daily['asia_c_cat'] = daily['asia_c'].apply(
    lambda x: 1 if x > ASIA_PRICE_STD else (-1 if x < -ASIA_PRICE_STD else 0)
)

return daily
```

def run_rolling_knn(daily: pd.DataFrame) -> pd.DataFrame:
“””
Rolling-window KNN prediction.
For each day i >= MIN_TRAIN_DAYS:
- Train on days [max(0, i-TRAIN_WINDOW) : i]
- Predict day i
“””
feature_cols = (
[‘west_view’, ‘asia_view’, ‘diff_west_close’]
+ [f’price_pos_{lb}’ for lb in PRICE_POS_LOOKBACKS]
+ [f’week_{d}’ for d in range(1, 6)]
)

```
daily = daily.copy().dropna(subset=feature_cols + ['asia_c_cat'])
daily = daily.reset_index()

predictions = []

for i in range(MIN_TRAIN_DAYS, len(daily)):
    train_start = max(0, i - TRAIN_WINDOW)
    train_df    = daily.iloc[train_start:i]
    test_row    = daily.iloc[[i]]
    
    X_train = train_df[feature_cols].values
    y_train = train_df['asia_c_cat'].values
    X_test  = test_row[feature_cols].values
    
    if len(np.unique(y_train)) < 2:
        predictions.append({'date': daily.iloc[i]['date'], 'knn_pred': 0})
        continue
    
    try:
        nca   = NeighborhoodComponentsAnalysis(random_state=42)
        knn   = KNeighborsClassifier(n_neighbors=KNN_NEIGHBORS)
        model = Pipeline([('nca', nca), ('knn', knn)])
        
        scaler  = StandardScaler()
        X_train_s = scaler.fit_transform(X_train)
        X_test_s  = scaler.transform(X_test)
        
        model.fit(X_train_s, y_train)
        pred = model.predict(X_test_s)[0]
    except Exception:
        pred = 0
    
    predictions.append({'date': daily.iloc[i]['date'], 'knn_pred': pred})

pred_df = pd.DataFrame(predictions).set_index('date')
result  = daily.set_index('date').join(pred_df, how='inner')
result  = result.dropna(subset=['knn_pred', 'asia_c'])

return result
```

def compute_pnl(result: pd.DataFrame) -> pd.DataFrame:
“””
PnL calculation:
- Signal = knn_pred (1=long, -1=short, 0=flat)
- Enter at ref_price (decision time)
- Exit at asia_close
- Daily PnL = signal * (asia_close - ref_price) - |signal| * transaction_cost
“””
result = result.copy()
result[‘signal’]    = result[‘knn_pred’]
result[‘raw_pnl’]   = result[‘signal’] * result[‘asia_c’]
result[‘tc’]        = result[‘signal’].abs() * TRANSACTION_COST
result[‘daily_pnl’] = result[‘raw_pnl’] - result[‘tc’]
result[‘cum_pnl’]   = result[‘daily_pnl’].cumsum()

```
# Position sizing: 1 lot = 1000 bbl (WTI futures)
result['daily_pnl_usd'] = result['daily_pnl'] * 1000
result['cum_pnl_usd']   = result['daily_pnl_usd'].cumsum()

return result
```

def compute_stats(result: pd.DataFrame) -> dict:
pnl = result[‘daily_pnl’]
n   = len(pnl)
ann = 252

```
stats = {
    'Total Days':        n,
    'Win Rate':          f"{(pnl > 0).mean()*100:.1f}%",
    'Avg Daily PnL':     f"${pnl.mean()*1000:,.0f}",
    'Total PnL':         f"${pnl.sum()*1000:,.0f}",
    'Ann. Return':       f"${pnl.mean()*1000*ann:,.0f}/yr",
    'Daily Vol':         f"${pnl.std()*1000:,.0f}",
    'Sharpe Ratio':      f"{pnl.mean()/pnl.std()*np.sqrt(ann):.2f}",
    'Max Drawdown':      f"${(result['cum_pnl_usd'] - result['cum_pnl_usd'].cummax()).min():,.0f}",
    'Long %':            f"{(result['signal'] == 1).mean()*100:.1f}%",
    'Short %':           f"{(result['signal'] == -1).mean()*100:.1f}%",
    'Flat %':            f"{(result['signal'] == 0).mean()*100:.1f}%",
}
return stats
```

def plot_results(result: pd.DataFrame, stats: dict):
“”“Plot cumulative PnL, rolling Sharpe, and signal distribution.”””

```
fig = plt.figure(figsize=(16, 12), facecolor='#0d1117')
