ax3.set_title('Monthly PnL Heatmap (USD)', color='#e6edf3', fontsize=11)

# ── 4. Daily PnL distribution ─────────────────────────────────────────────
pnl_vals = result['daily_pnl_usd'].dropna().values
ax4.hist(pnl_vals, bins=60, color='#58a6ff', alpha=0.7, edgecolor='none')
ax4.axvline(0, color='#f85149', lw=1)
