ax4 = fig.add_subplot(gs[2, 0])   # daily PnL distribution
ax5 = fig.add_subplot(gs[2, 1])   # signal breakdown

for ax in [ax1, ax2, ax3, ax4, ax5]:
    ax.set_facecolor('#161b22')
    ax.tick_params(colors='#8b949e', labelsize=9)
    ax.spines[:].set_color('#30363d')

idx = pd.to_datetime(result.index)
cum = result['cum_pnl_usd'].values
dd  = result['cum_pnl_usd'] - result['cum_pnl_usd'].cummax()

# ── 1. Cumulative PnL with drawdown shading ──────────────────────────────
ax1.fill_between(idx, dd.values, 0, alpha=0.3, color='#f85149', label='Drawdown')
ax1.plot(idx, cum, color='#58a6ff', lw=1.5, label='Cum PnL (1 lot)')
ax1.axhline(0, color='#30363d', lw=0.8)
ax1.set_title('Cumulative PnL — SGP Oil KNN Intraday Strategy', 
              color='#e6edf3', fontsize=13, fontweight='bold', pad=10)
ax1.set_ylabel('USD (1 lot = 1000 bbl)', color='#8b949e', fontsize=9)
ax1.yaxis.set_major_formatter(FuncFormatter(lambda x, _: f'${x:,.0f}'))
ax1.legend(facecolor='#161b22', edgecolor='#30363d', labelcolor='#8b949e', fontsize=9)

# Stats box
stats_text = '  |  '.join([f"{k}: {v}" for k, v in stats.items()])
ax1.text(0.01, 0.03, stats_text, transform=ax1.transAxes,
         color='#8b949e', fontsize=7.5, va='bottom',
         bbox=dict(facecolor='#0d1117', edgecolor='#30363d', alpha=0.8, pad=4))

# ── 2. Rolling Sharpe (63-day) ────────────────────────────────────────────
roll_sharpe = (
    result['daily_pnl'].rolling(63).mean() /
    result['daily_pnl'].rolling(63).std() * np.sqrt(252)
)
ax2.plot(idx, roll_sharpe.values, color='#3fb950', lw=1.2)
ax2.axhline(0, color='#30363d', lw=0.8)
ax2.axhline(1, color='#3fb950', lw=0.6, linestyle='--', alpha=0.5)
ax2.set_title('Rolling 63-day Sharpe', color='#e6edf3', fontsize=11)
ax2.set_ylabel('Sharpe', color='#8b949e', fontsize=9)

# ── 3. Monthly returns heatmap ────────────────────────────────────────────
result_copy = result.copy()
result_copy.index = pd.to_datetime(result_copy.index)
monthly = result_copy['daily_pnl_usd'].resample('ME').sum()
pivot = monthly.copy()
pivot.index = pd.MultiIndex.from_arrays(
    [pivot.index.year, pivot.index.month]
)
try:
    pivot_2d = pivot.unstack(level=1)
    pivot_2d.columns = ['Jan','Feb','Mar','Apr','May','Jun',
                         'Jul','Aug','Sep','Oct','Nov','Dec'][:len(pivot_2d.columns)]
    im = ax3.imshow(pivot_2d.values, aspect='auto', cmap='RdYlGn',
                    vmin=-np.abs(pivot_2d.values).max(),
                    vmax=np.abs(pivot_2d.values).max())
    ax3.set_xticks(range(len(pivot_2d.columns)))
    ax3.set_xticklabels(pivot_2d.columns, rotation=45, color='#8b949e', fontsize=8)
    ax3.set_yticks(range(len(pivot_2d.index)))
    ax3.set_yticklabels(pivot_2d.index, color='#8b949e', fontsize=8)
    for (r, c), val in np.ndenumerate(pivot_2d.values):
        if not np.isnan(val):
            ax3.text(c, r, f'{val/1000:.0f}k', ha='center', va='center',
                     fontsize=7, color='white' if abs(val) > pivot_2d.values[~np.isnan(pivot_2d.values)].std() else '#8b949e')
except Exception:
    ax3.text(0.5, 0.5, 'Monthly\nHeatmap', transform=ax3.transAxes,
