def run_backtest(df: pd.DataFrame, plot: bool = True) -> pd.DataFrame:
“””
Main entry point.

```
Args:
    df: DataFrame with index=Time (datetime), columns: Price, Asset, Contract, trading_day, Nearby
    plot: Whether to plot results

Returns:
    result: Daily DataFrame with signals, PnL, and all features
"""
print("Step 1/3: Building daily features from minute data...")
daily = build_daily_features(df)
print(f"  → {len(daily)} trading days constructed")

print("Step 2/3: Running rolling KNN predictions...")
result = run_rolling_knn(daily)
print(f"  → {len(result)} days with predictions")

print("Step 3/3: Computing PnL...")
result = compute_pnl(result)

stats = compute_stats(result)
print("\n=== STRATEGY STATISTICS ===")
for k, v in stats.items():
    print(f"  {k:<20} {v}")

if plot:
    plot_results(result, stats)

return result
```

